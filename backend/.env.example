PORT=3001
NODE_ENV=development
JWT_SECRET=change-me-use-a-long-random-secret-in-production
DATABASE_URL=postgres://postgres:postgres@localhost:5432/catalogohn
CORS_ORIGIN=http://localhost:5173
PUBLIC_API_URL=http://localhost:3001
DB_SETUP_SKIP_CREATE_DATABASE=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=30

# AWS preview/prod storage. Leave blank for local uploads fallback.
# Prefer an EC2/Beanstalk IAM role for S3 in preview/prod instead of static access keys.
AWS_REGION=us-east-1
S3_BUCKET=
S3_PUBLIC_URL=

# Optional Email SMTP (configured later)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="CatalogoHN Notifications <your_email@gmail.com>"
EMAIL_ADMIN_NOTIFY="admin@kolben.com"

# Preview example:
# NODE_ENV=production
# JWT_SECRET=<long-random-preview-secret>
# DATABASE_URL=postgres://<user>:<password>@<rds-endpoint>:5432/catalogohn_preview
# CORS_ORIGIN=https://preview.catalogohn.com
# PUBLIC_API_URL=https://api-preview.catalogohn.com
# DB_SETUP_SKIP_CREATE_DATABASE=true
# AWS_REGION=us-east-1
# S3_BUCKET=catalogohn-assets-preview
# S3_PUBLIC_URL=https://catalogohn-assets-preview.s3.us-east-1.amazonaws.com
