PORT=3001
NODE_ENV=production
JWT_SECRET=<long-random-preview-secret>
DATABASE_URL=postgres://catalogohn:<password>@localhost:5432/catalogohn_preview
CORS_ORIGIN=https://preview.catalogohn.com
PUBLIC_API_URL=https://api-preview.catalogohn.com
DB_SETUP_SKIP_CREATE_DATABASE=true

# Leave S3_BUCKET empty on DigitalOcean Droplet to use backend/uploads.
# S3_BUCKET=
# S3_PUBLIC_URL=

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=30

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<smtp-user>
SMTP_PASS=<smtp-app-password>
EMAIL_FROM=CatalogoHN <no-reply@catalogohn.com>
EMAIL_ADMIN_NOTIFY=<admin-preview-email>
