PORT=3001
NODE_ENV=production
JWT_SECRET=<generar-un-secreto-largo-y-aleatorio>
DATABASE_URL=postgres://catalogohn:<password>@localhost:5432/catalogohn
CORS_ORIGIN=https://catalogohn.com,https://api.catalogohn.com,https://preview.catalogohn.com
PUBLIC_API_URL=https://api.catalogohn.com
DB_SETUP_SKIP_CREATE_DATABASE=true

# Almacenamiento local en DigitalOcean Droplet (backend/uploads)
# S3_BUCKET=
# S3_PUBLIC_URL=

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=30

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<tu-correo-gmail>
SMTP_PASS=<tu-password-de-aplicacion-gmail>
EMAIL_FROM=CatalogoHN <no-reply@catalogohn.com>
EMAIL_ADMIN_NOTIFY=admin@catalogohn.com
